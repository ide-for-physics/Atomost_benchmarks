&control
  calculation = 'relax'
  prefix = 'cds'
  pseudo_dir = '../pseudo'
  outdir = './'
  tprnfor = .true.
  tstress = .true.
  forc_conv_thr = 1.0d-4
  etot_conv_thr = 1.0d-6
  verbosity = 'high'
/
&system
  ibrav = 0
  nat = 4
  ntyp = 2
  ecutwfc = 100
  nbnd = 40
  occupations = 'fixed'
/
&electrons
  conv_thr = 1.0d-11
  diago_thr_init = 5.0d-6
  mixing_beta = 0.5
/
&ions
  ion_dynamics = 'bfgs'
/

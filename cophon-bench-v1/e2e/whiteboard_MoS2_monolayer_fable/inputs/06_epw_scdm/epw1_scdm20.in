--
&inputepw
  prefix      = 'mos2'
  outdir      = '../03_nscf/tmp_scdm'
  dvscf_dir   = '../02_ph/save'

  elph        = .true.
  epbwrite    = .false.
  epbread     = .false.
  epwwrite    = .true.
  epwread     = .false.

  etf_mem     = 1
  lpolar      = .false.
  vme         = 'wannier'
  use_ws      = .false.
  lifc        = .false.
  asr_typ     = 'simple'

  nbndsub     = 20
  bands_skipped = 'exclude_bands = 1-6'

  wannierize  = .true.
  num_iter    = 3000
  iprint      = 2
  dis_win_min = -7.0
  dis_win_max = 12.0
  dis_froz_min = -7.0
  dis_froz_max = 7.0
  scdm_proj   = .true.
  auto_projections = .true.
  scdm_entanglement = 'erfc'
  scdm_mu     = 7.0
  scdm_sigma  = 2.0
  wdata(1)  = 'bands_plot = .true.'
  wdata(2)  = 'begin kpoint_path'
  wdata(3)  = 'G 0.00 0.00 0.00 M 0.50 0.00 0.00'
  wdata(4)  = 'M 0.50 0.00 0.00 K 0.333333333333 0.333333333333 0.00'
  wdata(5)  = 'K 0.333333333333 0.333333333333 0.00 G 0.0 0.0 0.00'
  wdata(6)  = 'end kpoint_path'
  wdata(7)  = 'bands_plot_format = gnuplot'
  wdata(8)  = 'dis_num_iter = 10000'
  wdata(9)  = 'num_print_cycles = 50'
  wdata(10) = 'dis_mix_ratio = 0.5'
  wdata(11) = 'conv_tol = 1E-9'
  wdata(12) = 'conv_window = 5'
  wdata(13) = 'bands_num_points = 60'
  wdata(14) = 'dis_conv_tol = 1E-10'

  elecselfen  = .false.
  phonselfen  = .false.
  a2f         = .false.

  fsthick     = 20.0
  nstemp      = 1
  temps       = 300
  degaussw    = 0.025
  eps_acoustic = 5.0

  efermi_read = .true.
  fermi_energy = 0.3675

  band_plot   = .true.
  filkf       = '../03_nscf/path_GMKG.kpt'
  nqf1 = 1, nqf2 = 1, nqf3 = 1

  nk1 = 12, nk2 = 12, nk3 = 1
  nq1 = 1,  nq2 = 1,  nq3 = 1
/

&inputepw
  prefix      = 'sns2'
  outdir      = '../tmp'
  dvscf_dir   = '../save'
  amass(1)    = 118.710
  amass(2)    = 32.060
  iverbosity  = 0

  elph        = .true.
  epwwrite    = .true.
  epwread     = .false.
  etf_mem     = 1
  vme         = 'wannier'
  lpolar      = .false.
  asr_typ     = 'crystal'

  nbndsub     = 17
  bands_skipped = 'exclude_bands = 1-5'

  wannierize  = .true.
  num_iter    = 400
  iprint      = 2
  dis_win_min = -8.0
  dis_win_max = 22.5
  dis_froz_min = -8.0
  dis_froz_max = 14.6
  proj(1) = 'Sn:s;p;d'
  proj(2) = 'S:s;p'
  wdata(1) = 'dis_num_iter = 400'
  wdata(2) = 'num_print_cycles = 50'
  wdata(3) = 'conv_tol = 1E-7'
  wdata(4) = 'conv_window = 4'
  wdata(5) = 'guiding_centres = .true.'
  wdata(6) = 'dis_mix_ratio = 0.8'

  band_plot   = .true.
  filkf       = 'kpath_bands.txt'
  filqf       = 'qgamma.txt'

  elecselfen  = .false.
  phonselfen  = .false.
  a2f         = .false.

  nk1 = 12, nk2 = 12, nk3 = 6
  nq1 = 1,  nq2 = 1,  nq3 = 1
 /

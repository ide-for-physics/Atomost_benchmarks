&inputepw
  prefix      = 'sns2'
  outdir      = '../tmp'
  dvscf_dir   = '../save'
  amass(1)    = 118.710
  amass(2)    = 32.060
  iverbosity  = 0

  elph        = .true.
  epwwrite    = .false.
  epwread     = .true.
  etf_mem     = 1
  vme         = 'wannier'
  lpolar      = .false.
  asr_typ     = 'crystal'

  nbndsub     = 17
  bands_skipped = 'exclude_bands = 1-5'

  wannierize  = .false.

  band_plot   = .true.
  filkf       = 'kpath_bands.txt'
  filqf       = 'qgamma.txt'

  elecselfen  = .false.
  phonselfen  = .false.
  a2f         = .false.

  nk1 = 12, nk2 = 12, nk3 = 6
  nq1 = 1,  nq2 = 1,  nq3 = 1
 /

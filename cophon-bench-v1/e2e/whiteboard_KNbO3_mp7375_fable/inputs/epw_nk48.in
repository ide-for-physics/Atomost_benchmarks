--
&inputepw
  prefix      = 'kno'
  amass(1)    = 39.0983
  amass(2)    = 92.90638
  amass(3)    = 15.9994
  outdir      = './tmp'
  dvscf_dir   = './save'

  elph        = .true.
  epbwrite    = .false.
  epbread     = .false.
  epwwrite    = .false.
  epwread     = .true.
  etf_mem     = 1
  lpolar      = .false.
  asr_typ     = 'crystal'
  use_ws      = .true.
  vme         = 'wannier'

  wannierize  = .false.
  nbndsub     = 21
  bands_skipped = 'exclude_bands = 1-11'

  ! ---- coherent-phonon generation kernel (kernel variant of EPW, lindabs driver)
  lindabs     = .true.
  ladsmear    = .false.
  omegamin    = 0.02
  omegamax    = 6.0
  omegastep   = 0.02
  degaussw    = 0.025
  temps       = 300
  efermi_read = .true.
  fermi_energy = 9.51
  fsthick     = 1.0d10
  eps_acoustic = 5.0

  elecselfen  = .false.
  phonselfen  = .false.
  a2f         = .false.

  nk1 = 8, nk2 = 8, nk3 = 8
  nq1 = 1, nq2 = 1, nq3 = 1
  nkf1 = 48, nkf2 = 48, nkf3 = 48
  nqf1 = 1, nqf2 = 1, nqf3 = 1
/

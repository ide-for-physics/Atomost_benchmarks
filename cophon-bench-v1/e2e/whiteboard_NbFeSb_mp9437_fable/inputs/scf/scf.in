&control
  calculation = 'scf'
  prefix = 'nfs'
  outdir = './tmp'
  pseudo_dir = '../pp'
  tprnfor = .true.
  tstress = .true.
  verbosity = 'high'
/
&system
  ibrav = 0
  nat = 3
  ntyp = 3
  ecutwfc = 90
  ecutrho = 360
  occupations = 'fixed'
  nbnd = 26
/
&electrons
  conv_thr = 1.0d-10
  diago_thr_init = 5.0d-6
  mixing_beta = 0.5
/

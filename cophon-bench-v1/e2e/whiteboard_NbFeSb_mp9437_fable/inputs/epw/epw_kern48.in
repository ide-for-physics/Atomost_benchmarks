&inputepw
  prefix      = 'nfs'
  amass(1)    = 92.90637
  amass(2)    = 55.845
  amass(3)    = 121.760
  outdir      = './tmp_nscf'
  dvscf_dir   = './save'
  iverbosity  = 0

  elph        = .true.
  epwwrite    = .false.
  epwread     = .true.
  etf_mem     = 1
  vme         = 'wannier'
  lpolar      = .true.
  wannierize  = .false.
  nbndsub     = 19
  bands_skipped = 'exclude_bands = 1:13'

  elecselfen  = .false.
  phonselfen  = .false.
  a2f         = .false.

  lindabs     = .true.
  omegamin    = 0.01
  omegamax    = 6.0
  omegastep   = 0.01
  eps_acoustic= 5.0

  efermi_read = .true.
  fermi_energy= 17.24
  temps       = 300
  degaussw    = 0.025
  fsthick     = 100.0

  nkf1 = 48, nkf2 = 48, nkf3 = 48
  nqf1 = 1, nqf2 = 1, nqf3 = 1
  nk1  = 8, nk2  = 8, nk3  = 8
  nq1  = 1, nq2  = 1, nq3  = 1
/

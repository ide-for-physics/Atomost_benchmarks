--
&inputepw
  prefix      = 'gap'
  amass(1)    = 69.723
  amass(2)    = 30.973762
  outdir      = '../03_wan/tmp'
  dvscf_dir   = '../02_ph/save'
  iverbosity  = 1

  elph        = .true.
  epbwrite    = .false.
  epbread     = .false.
  epwwrite    = .true.
  epwread     = .false.
  etf_mem     = 1
  lpolar      = .true.
  vme         = 'wannier'

  nbndsub     = 13
  bands_skipped = 'exclude_bands = 1-5'
  wannierize  = .false.
  num_iter    = 1000
  iprint      = 2
  dis_win_min = -6.0
  dis_win_max = 35.0
  dis_froz_min= -6.0
  dis_froz_max= 16.0
  proj(1)     = 'Ga:s;p'
  proj(2)     = 'P:s;p;d'
  wdata(1)    = 'bands_plot = .true.'
  wdata(2)    = 'begin kpoint_path'
  wdata(3)    = 'L 0.500 0.500 0.500  G 0.000 0.000 0.000'
  wdata(4)    = 'G 0.000 0.000 0.000  X 0.500 0.000 0.500'
  wdata(5)    = 'X 0.500 0.000 0.500  W 0.500 0.250 0.750'
  wdata(6)    = 'W 0.500 0.250 0.750  K 0.375 0.375 0.750'
  wdata(7)    = 'K 0.375 0.375 0.750  G 0.000 0.000 0.000'
  wdata(8)    = 'end kpoint_path'
  wdata(9)    = 'bands_num_points = 60'
  wdata(10)   = 'bands_plot_format = gnuplot'
  wdata(11)   = 'guiding_centres = .true.'
  wdata(12)   = 'dis_num_iter = 1500'
  wdata(13)   = 'dis_mix_ratio = 0.5'
  wdata(14)   = 'conv_tol = 1e-8'
  wdata(15)   = 'conv_window = 5'
  wdata(16)   = 'num_print_cycles = 50'
  wdata(17)   = 'dis_conv_tol = 1e-9'

  elecselfen  = .false.
  phonselfen  = .false.
  a2f         = .false.
  lindabs     = .false.

  fsthick     = 20.0
  temps       = 300.0
  degaussw    = 0.025
  efermi_read = .true.
  fermi_energy= 8.43

  nk1         = 12
  nk2         = 12
  nk3         = 12
  nq1         = 6
  nq2         = 6
  nq3         = 6
  nkf1        = 6
  nkf2        = 6
  nkf3        = 6
  nqf1        = 1
  nqf2        = 1
  nqf3        = 1
 /

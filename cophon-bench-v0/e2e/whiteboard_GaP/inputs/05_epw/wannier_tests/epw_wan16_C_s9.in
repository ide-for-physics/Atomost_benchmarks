&inputepw
  prefix      = 'gap'
  amass(1)    = 69.723
  amass(2)    = 30.973762
  outdir      = './'
  dvscf_dir   = './save'
  iverbosity  = 0
  elph        = .false.
  wannierize  = .true.
  num_iter    = 1000
  iprint      = 2
  bands_skipped = 'exclude_bands = 1:5'
  dis_win_min = -6.0
  dis_froz_min = -6.0
  nbndsub     = 9
  dis_win_max = 22.0
  dis_froz_max = 15.5
  scdm_proj = .true.
  auto_projections = .true.
  scdm_entanglement = 'erfc'
  scdm_mu = 15.5
  scdm_sigma = 1.5
  wdata(1)  = 'bands_plot = .true.'
  wdata(2)  = 'begin kpoint_path'
  wdata(3)  = 'G 0.000 0.000 0.000 X 0.000 0.500 0.500'
  wdata(4)  = 'X 0.000 0.500 0.500 W 0.250 0.500 0.750'
  wdata(5)  = 'W 0.250 0.500 0.750 K 0.375 0.375 0.750'
  wdata(6)  = 'K 0.375 0.375 0.750 G 0.000 0.000 0.000'
  wdata(7)  = 'G 0.000 0.000 0.000 L 0.500 0.500 0.500'
  wdata(8)  = 'end kpoint_path'
  wdata(9)  = 'bands_num_points = 60'
  wdata(10) = 'bands_plot_format = gnuplot'
  wdata(11) = 'dis_num_iter = 2000'
  wdata(12) = 'dis_mix_ratio = 0.8'
  wdata(13) = 'dis_conv_tol = 1.0d-9'
  wdata(14) = 'conv_tol = 1.0d-9'
  wdata(15) = 'conv_window = 5'
  wdata(16) = 'num_print_cycles = 100'
  wdata(17) = 'use_ws_distance = .true.'
  nk1 = 16
  nk2 = 16
  nk3 = 16
  nq1 = 2
  nq2 = 2
  nq3 = 2
 /

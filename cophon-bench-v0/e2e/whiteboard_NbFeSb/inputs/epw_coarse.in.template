  elecselfen  = .false.
  phonselfen  = .false.
  band_plot   = .true.
  filkf       = './kpath_epw.kpt'
  filqf       = './qgamma.kpt'

  fsthick     = 100.0 ! eV
  degaussw    = 0.025 ! eV
  nstemp      = 1
  temps       = 300
  efermi_read = .true.

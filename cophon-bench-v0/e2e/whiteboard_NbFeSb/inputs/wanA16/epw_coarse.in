--
&inputepw
  prefix      = 'nbfesb'
  amass(1)    = 92.90638
  amass(2)    = 55.845
  amass(3)    = 121.760
  outdir      = '../tmp_nscf'
  dvscf_dir   = '../save'

  elph        = .true.
  epbwrite    = .false.
  epbread     = .false.
  epwwrite    = .true.
  epwread     = .false.
  etf_mem     = 1
  vme         = 'wannier'
  lpolar      = .false.
  asr_typ     = 'crystal'

  nbndsub     = 16
  bands_skipped = 'exclude_bands = 1-13'

  wannierize  = .true.
  num_iter    = 1000
  iprint      = 2
  dis_win_min = 4.0
  dis_win_max = 28.0
  dis_froz_min= 4.0
  dis_froz_max= 22.3
  proj(1)     = 'Nb:s;d'
  proj(2)     = 'Fe:s;d'
  proj(3)     = 'Sb:s;p'
  wdata(1)    = 'dis_num_iter = 2000'
  wdata(2)    = 'num_print_cycles = 50'
  wdata(3)    = 'dis_mix_ratio = 0.5'
  filukk      = './nbfesb.ukk'

  elecselfen  = .false.
  phonselfen  = .false.
  band_plot   = .true.
  filkf       = '../kpath_epw.kpt'
  filqf       = '../qgamma.kpt'

  fsthick     = 100.0 ! eV
  degaussw    = 0.025 ! eV
  nstemp      = 1
  temps       = 300
  efermi_read = .true.
  fermi_energy= 16.7522

  nk1 = 10, nk2 = 10, nk3 = 10
  nq1 = 1,  nq2 = 1,  nq3 = 1
 /

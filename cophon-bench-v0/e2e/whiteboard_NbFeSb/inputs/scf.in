&control
  calculation = 'scf'
  prefix      = 'nbfesb'
  outdir      = './tmp'
  pseudo_dir  = './pseudo'
  tprnfor     = .true.
  tstress     = .true.
  verbosity   = 'high'
/
&system
  ibrav   = 0
  nat     = 3
  ntyp    = 3
  ecutwfc = 90.0
  ecutrho = 360.0
  occupations = 'fixed'
  nbnd    = 40
/
&electrons
  conv_thr    = 1.0d-10
  mixing_beta = 0.5
/
